<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_demo_mode" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.demo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <setting id="purchase_demo_mode"
                         help="Muestra en las RFQ enviadas el botón &quot;Simular respuesta del proveedor&quot;. Apágalo en producción: ahí la respuesta llega por correo.">
                    <field name="purchase_demo_mode"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
