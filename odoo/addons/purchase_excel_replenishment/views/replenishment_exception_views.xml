<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_replenishment_exception_tree" model="ir.ui.view">
        <field name="name">purchase.replenishment.exception.tree</field>
        <field name="model">purchase.replenishment.exception</field>
        <field name="arch" type="xml">
            <tree create="0" decoration-muted="state == 'resolved'">
                <header>
                    <button name="action_accept" type="object" string="Aceptar"/>
                    <button name="action_reopen" type="object" string="Reabrir"/>
                </header>
                <field name="code"/>
                <field name="exception_type"/>
                <field name="detail"/>
                <field name="decision" optional="hide"/>
                <field name="sheet" optional="hide"/>
                <field name="excel_row" optional="hide"/>
                <field name="group" widget="badge"
                       decoration-success="group == 'corrected'" decoration-warning="group == 'warning'"
                       decoration-danger="group == 'excluded'" decoration-info="group == 'purchase'"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'" decoration-success="state == 'resolved'"
                       decoration-info="state == 'accepted'"/>
                <field name="times_seen"/>
                <field name="days_open"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </tree>
        </field>
    </record>

    <record id="view_replenishment_exception_form" model="ir.ui.view">
        <field name="name">purchase.replenishment.exception.form</field>
        <field name="model">purchase.replenishment.exception</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_accept" type="object" string="Aceptar" class="btn-primary"
                            invisible="state != 'pending'"/>
                    <button name="action_reopen" type="object" string="Reabrir" invisible="state != 'accepted'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="display_label"/></h1></div>
                    <group>
                        <group string="Qué venía en el Excel">
                            <field name="sheet"/>
                            <field name="excel_row"/>
                            <field name="code"/>
                            <field name="exception_type"/>
                            <field name="original_value"/>
                        </group>
                        <group string="Qué se hizo">
                            <field name="detail"/>
                            <field name="decision"/>
                            <field name="group"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Seguimiento">
                            <field name="first_seen"/>
                            <field name="last_seen"/>
                            <field name="times_seen"/>
                            <field name="days_open"/>
                            <field name="reopen_count"/>
                        </group>
                        <group string="Cierre">
                            <field name="resolved_at" invisible="not resolved_at"/>
                            <field name="accepted_by" invisible="not accepted_by"/>
                            <field name="accepted_at" invisible="not accepted_at"/>
                            <field name="last_import_id"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_replenishment_exception_search" model="ir.ui.view">
        <field name="name">purchase.replenishment.exception.search</field>
        <field name="model">purchase.replenishment.exception</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="exception_type"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
                <filter name="accepted" string="Aceptadas" domain="[('state', '=', 'accepted')]"/>
                <filter name="resolved" string="Resueltas" domain="[('state', '=', 'resolved')]"/>
                <separator/>
                <filter name="mine" string="Mías" domain="[('user_id', '=', uid)]"/>
                <group expand="1" string="Agrupar por">
                    <filter name="group_by_group" string="Grupo" context="{'group_by': 'group'}"/>
                    <filter name="group_by_type" string="Tipo" context="{'group_by': 'exception_type'}"/>
                    <filter name="group_by_state" string="Estatus" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_replenishment_exceptions" model="ir.actions.act_window">
        <field name="name">Excepciones de inventario</field>
        <field name="res_model">purchase.replenishment.exception</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_pending': 1, 'search_default_group_by_group': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin excepciones pendientes</p>
            <p>Cada importación del Excel deja aquí lo que venía mal, asignado al comprador.</p>
        </field>
    </record>

    <menuitem id="menu_replenishment_exceptions"
              name="Excepciones de inventario"
              parent="purchase.menu_procurement_management"
              action="action_replenishment_exceptions"
              groups="purchase.group_purchase_user"
              sequence="21"/>

    <record id="view_replenishment_import_form" model="ir.ui.view">
        <field name="name">purchase.replenishment.import.form</field>
        <field name="model">purchase.replenishment.import</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_open_pending" type="object" string="Ver excepciones pendientes"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="filename"/>
                        </group>
                        <group>
                            <field name="new_count"/>
                            <field name="open_count"/>
                            <field name="resolved_count"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
</odoo>
